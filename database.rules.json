{
  "rules": {
    "testimonials": {
      ".read": true,
      ".write": "auth != null"
    },
    "testimonialSubmissions": {
      ".read": "auth != null",
      "$submissionId": {
        ".write": "(auth != null) || (newData.hasChildren(['name', 'company', 'testimonial']) && !data.exists())"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "adminUsers": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$userId": {
        ".write": false
      }
    },
    "content": {
      ".read": true,
      "$contentId": {
        ".write": "(auth != null) || (!data.exists() && newData.child('status').val() === 'pending')"
      }
    },
    "cards": {
      ".read": true,
      ".write": "auth != null"
    },
    "clientLogos": {
      ".read": true,
      ".write": "auth != null"
    },
    "clientShowcase2Logos": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
